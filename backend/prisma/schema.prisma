generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  favorite  Boolean  @default(false)
  color     String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
